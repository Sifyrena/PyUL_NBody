           RowBox[{"Derivative", "[", "#", "]"}], "[", "f", "]"}], "[", "i", 
          "]"}], "&"}], ",", 
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", 
          RowBox[{"NodeNum", "+", "5"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"serie", "=", 
      RowBox[{"Expand", "[", 
       RowBox[{"eqn", "//.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"f", "[", 
            RowBox[{"i", "+", "k_"}], "]"}], "->", 
