Cell[BoxData[{
 RowBox[{
  RowBox[{"work2", " ", "=", " ", 
   RowBox[{"FindMinimum", "[", 
    RowBox[{"testterm", " ", ",", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         SubscriptBox["f", "i"], ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", 
         RowBox[{"nval", "-", "1"}]}], "}"}]}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"results", " ", "=", " ", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"i", " ", "hval"}], " ", ",", 
         SubscriptBox["f", "i"]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "0", ",", "nval"}], "}"}]}], " ", "]"}], "/.", " ", 
     
     RowBox[{"work2", "[", 
      RowBox[{"[", "2", "]"}], "]"}]}]}], " ", ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ListPlot", "[", "results", "]"}], "  "}]}], "Input",
 CellGroupingRules->{"GroupTogetherGrouping", 10001.},
