 CellLabel->"Out[6]=",ExpressionUUID->"9cb5689c-66ef-481f-a584-0bba3f7b8566"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"nval", " ", "=", " ", "200"}], "  ", ";"}], 
  RowBox[{"(*", " ", 
   RowBox[{"number", " ", "of", " ", "points"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"hval", " ", "=", " ", 
    RowBox[{"4", " ", 
     RowBox[{"Pi", " ", "/", "nval"}]}]}], "  ", ";"}], 
  RowBox[{"(*", " ", 
   RowBox[{"this", " ", "will", " ", "be", " ", "two", " ", "periods"}], "  ",
    "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "this", " ", "a", " ", "\"\<test\>\"", " ", "function", " ", "which", " ",
      "tends", " ", "to", " ", "zero", " ", "if", " ", "the", " ", 
     SubscriptBox["f", 
      RowBox[{"i", " "}]], "solve", " ", "our", " ", "equation"}], ",", " ", 
    RowBox[{
     RowBox[{"and", " ", "it", " ", "is", " ", "positive", " ", "definite"}], 
     ";", " ", 
     RowBox[{"the", " ", 
      SubscriptBox["f", 
       RowBox[{"0", " "}]], "and", " ", 
      SubscriptBox["f", 
       RowBox[{"nval", " "}]], "assignments", " ", "fix", " ", "the", " ", 
      "boundary", " ", "conditions"}]}]}], "  ", "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "the", " ", "structure", " ", "of", " ", "this", " ", "term", " ", "has", " ",
     "a", " ", "\"\<left difference\>\"", " ", "and", 
    " ", "\"\<right difference\>\"", " ", "at", " ", "each", " ", "end"}], 
   " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"testterm", " ", "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"div2left", " ", "+", "  ", 
         SubscriptBox["f", "0"]}], ")"}], "^", "2"}], "    ", "+", " ", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"div2middle", " ", "+", "  ", 
           SubscriptBox["f", 
            RowBox[{"i", " "}]]}], ")"}], "^", "2"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{"nval", "-", "1"}]}], "}"}]}], "]"}], "  ", "+", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"div2right", " ", "+", "  ", 
         SubscriptBox["f", "nval"]}], ")"}], "^", "2"}]}], "  ", "//.", "  ", 
     
     RowBox[{"{", 
      RowBox[{
       RowBox[{"h", "->", " ", "hval"}], " ", ",", " ", 
       RowBox[{"fun", "->", " ", "f"}], ",", 
       RowBox[{
        SubscriptBox["f", 
         RowBox[{"0", " "}]], "->", " ", "1"}], ",", 
       RowBox[{"n", "->", "nval"}], ",", " ", 
       RowBox[{
        SubscriptBox["f", 
         RowBox[{"nval", " "}]], "->", " ", "1"}]}], "}"}]}]}], " ", ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]"}], "Input",
 CellGroupingRules->{"GroupTogetherGrouping", 10001.},
 CellChangeTimes->{{3.957853660417233*^9, 3.957853675968828*^9}, {
  3.957853708067526*^9, 3.957853944710788*^9}, {3.9578543315059233`*^9, 
