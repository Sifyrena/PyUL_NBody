Cell[TextData[StyleBox["From \
https://demonstrations.wolfram.com/FiniteDifferenceSchemesOfOneVariable/ \n\
Took a bit of figuring out, but it writes out finite difference \"stencils\"\n\
\nnodenum -- number of nodes (sets accuracy) \nDerNode -- node to vary about; \
lets you put in \"one-sided\" difference schemes\n DerOrder -- order of \
derivative  \n f -- name of the function x",
 FontColor->RGBColor[
  0.00006103608758678569, 0.0018005645838101779`, 
   0.9982299534599832]]], "Text",
 CellGroupingRules->{"GroupTogetherGrouping", 10000.},
 CellChangeTimes->{
