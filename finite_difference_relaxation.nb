Cell[CellGroupData[{

Cell["Now we solve the soliton profile", "Section",
 CellChangeTimes->{{3.957856619915038*^9, 3.9578566201773567`*^9}, {
  3.957856688815647*^9, 3.957856718029531*^9}, {3.9578572894734573`*^9, 
  3.957857370779784*^9}, {3.9578890758790207`*^9, 
  3.957889103639415*^9}},ExpressionUUID->"d576c004-34d4-4e0d-b26c-\
e4ef9ee980e6"],

Cell[TextData[StyleBox["The equations below generate a finite difference \
approximation to the  f and \[CapitalPhi] equations for the soliton profile; \
they are designed to keep them \[OpenCurlyDoubleQuote]in domain\
\[CloseCurlyDoubleQuote] so they become increasingly \
\[OpenCurlyDoubleQuote]one sided\[CloseCurlyDoubleQuote] at the endpoints. \n\
\nThe apparent singularity at the origin is avoided, since the f\
\[CloseCurlyQuote] term is omitted at i=0. More complicated potentials should \
be relatively easy  to add.  ",
 FontColor->RGBColor[
  0.00006103608758678569, 0.0018005645838101779`, 
   0.9982299534599832]]], "Text",
 CellChangeTimes->{{3.957910103897337*^9, 3.957910105833276*^9}, {
   3.957918235961187*^9, 3.9579182419219646`*^9}, 3.9579336170916767`*^9, {
   3.957936708443048*^9, 3.957936856716044*^9}, {3.957938386048855*^9, 
   3.957938386291176*^9}},ExpressionUUID->"b709156a-2950-452a-a1e9-\
22f5894d9bb9"],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"termf", "[", 
     RowBox[{"ival_", ",", "n_", ",", "order_"}], "]"}], " ", ":=", " ", 
    RowBox[{
     RowBox[{"Which", "[", 
      RowBox[{
       RowBox[{"ival", "==", "0"}], ",", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           RowBox[{"FinDiffScheme", "[", 
            RowBox[{"order", ",", "1", ",", "2", ",", "f"}], "]"}]}], "/", 
          "2"}], "     ", "+", " ", 
         RowBox[{
          RowBox[{"f", "[", "ival", "]"}], 
          RowBox[{"\[Phi]", "[", "ival", "]"}]}], " ", "+", " ", 
         RowBox[{"\[Lambda]int", " ", 
          RowBox[{
           RowBox[{"f", "[", "ival", "]"}], "^", "3"}]}]}], " ", ")"}], " ", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"enforces", " ", 
          RowBox[{
           RowBox[{"f", "'"}], "[", "0", "]"}]}], "=", "0"}], " ", "*)"}], 
       " ", ",", " ", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       "              ", 
       RowBox[{"ival", " ", "<=", "  ", 
        RowBox[{"order", "/", "2"}]}], " ", ",", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           RowBox[{"FinDiffScheme", "[", " ", 
            RowBox[{"order", ",", 
             RowBox[{"ival", "+", "1"}], ",", "2", ",", "f"}], "]"}]}], "/", 
          "2"}], "  ", "-", " ", 
         RowBox[{
          RowBox[{"FinDiffScheme", "[", " ", 
           RowBox[{"order", ",", 
            RowBox[{"ival", "+", "1"}], ",", "1", ",", "f"}], "]"}], " ", "/", 
          RowBox[{"(", 
           RowBox[{"ival", " ", "h"}], ")"}]}], "   ", "+", " ", 
         RowBox[{
          RowBox[{"f", "[", "ival", "]"}], 
          RowBox[{"\[Phi]", "[", "ival", "]"}]}], "  ", "+", " ", 
         RowBox[{"\[Lambda]int", " ", 
          RowBox[{
           RowBox[{"f", "[", "ival", "]"}], "^", "3"}]}]}], ")"}], "  ", ",", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"order", "/", "2"}], " ", "<", " ", "ival", " ", "<", " ", 
        RowBox[{"n", "-", 
         RowBox[{"order", "/", "2"}]}]}], ",", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           RowBox[{"FinDiffScheme", "[", " ", 
            RowBox[{"order", ",", 
             RowBox[{
              RowBox[{"Floor", "[", 
               RowBox[{"order", "/", "2"}], "]"}], "+", "1"}], ",", "2", ",", 
             "f"}], "]"}]}], "/", "2"}], "  ", "-", " ", 
         RowBox[{
          RowBox[{"FinDiffScheme", "[", " ", 
           RowBox[{"order", ",", 
            RowBox[{
             RowBox[{"Floor", "[", 
              RowBox[{"order", "/", "2"}], "]"}], "+", "1"}], ",", "1", ",", 
            "f"}], "]"}], " ", "/", 
          RowBox[{"(", 
           RowBox[{"ival", " ", "h"}], ")"}]}], "   ", "+", " ", 
         RowBox[{
          RowBox[{"f", "[", "ival", "]"}], 
          RowBox[{"\[Phi]", "[", "ival", "]"}]}], "+", " ", 
         RowBox[{"\[Lambda]int", " ", 
          RowBox[{
           RowBox[{"f", "[", "ival", "]"}], "^", "3"}]}]}], ")"}], " ", ",", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", " ", 
       RowBox[{
        RowBox[{"n", "-", 
         RowBox[{"order", "/", "2"}]}], "  ", "<=", " ", "ival"}], ",", " ", 
       "\[IndentingNewLine]", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           RowBox[{"FinDiffScheme", "[", " ", 
            RowBox[{"order", ",", 
             RowBox[{"order", "-", "n", "+", "ival"}], ",", "2", ",", "f"}], 
            "]"}]}], "/", "2"}], "  ", "-", " ", 
         RowBox[{
          RowBox[{"FinDiffScheme", "[", " ", 
           RowBox[{"order", ",", 
            RowBox[{"order", "-", "n", "+", "ival"}], ",", "1", ",", "f"}], 
           "]"}], " ", "/", 
          RowBox[{"(", 
           RowBox[{"ival", " ", "h"}], ")"}]}], "   ", "+", " ", 
         RowBox[{
          RowBox[{"f", "[", "ival", "]"}], 
          RowBox[{"\[Phi]", "[", "ival", "]"}]}], " ", "+", " ", 
         RowBox[{"\[Lambda]int", " ", 
          RowBox[{
           RowBox[{"f", "[", "ival", "]"}], "^", "3"}]}]}], ")"}]}], "  ", 
      "\[IndentingNewLine]", " ", "]"}], " ", "//.", " ", 
     RowBox[{"{", 
      RowBox[{"i", "->", " ", "ival"}], "  ", "}"}]}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"termphi", "[", 
     RowBox[{"ival_", ",", "n_", ",", "order_"}], "]"}], " ", ":=", " ", 
    RowBox[{
     RowBox[{"Which", "[", 
      RowBox[{
       RowBox[{"ival", "==", "0"}], ",", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"FinDiffScheme", "[", 
          RowBox[{"order", ",", "1", ",", "2", ",", "\[Phi]"}], "]"}], 
         "     ", "-", 
         RowBox[{"4", " ", "Pi", " ", 
          RowBox[{
           RowBox[{"f", "[", "ival", "]"}], "^", "2"}]}]}], "  ", ")"}], " ", 
       
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"enforces", " ", 
          RowBox[{
           RowBox[{"f", "'"}], "[", "0", "]"}]}], "=", "0"}], " ", "*)"}], 
       " ", ",", " ", "\[IndentingNewLine]", "              ", 
       RowBox[{"ival", " ", "<=", "  ", 
        RowBox[{"order", "/", "2"}]}], " ", ",", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"FinDiffScheme", "[", " ", 
          RowBox[{"order", ",", 
           RowBox[{"ival", "+", "1"}], ",", "2", ",", "\[Phi]"}], "]"}], 
         "   ", "+", " ", 
         RowBox[{"2", "  ", 
          RowBox[{
           RowBox[{"FinDiffScheme", "[", " ", 
            RowBox[{"order", ",", 
             RowBox[{"ival", "+", "1"}], ",", "1", ",", "\[Phi]"}], "]"}], 
           " ", "/", 
           RowBox[{"(", 
            RowBox[{"ival", " ", "h"}], ")"}]}]}], "   ", "-", 
         RowBox[{"4", " ", "Pi", " ", 
          RowBox[{
           RowBox[{"f", "[", "ival", "]"}], "^", "2"}]}]}], "    ", ")"}], 
       " ", ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"order", "/", "2"}], " ", "<", " ", "ival", " ", "<", " ", 
        RowBox[{"n", "-", 
         RowBox[{"order", "/", "2"}]}]}], ",", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"FinDiffScheme", "[", " ", 
          RowBox[{"order", ",", 
           RowBox[{
            RowBox[{"Floor", "[", 
             RowBox[{"order", "/", "2"}], "]"}], "+", "1"}], ",", "2", ",", 
           "\[Phi]"}], "]"}], "   ", "+", " ", 
         RowBox[{"2", " ", 
          RowBox[{
           RowBox[{"FinDiffScheme", "[", " ", 
            RowBox[{"order", ",", 
             RowBox[{
              RowBox[{"Floor", "[", 
               RowBox[{"order", "/", "2"}], "]"}], "+", "1"}], ",", "1", ",", 
             "\[Phi]"}], "]"}], " ", "/", 
           RowBox[{"(", 
            RowBox[{"ival", " ", "h"}], ")"}]}]}], "   ", "-", 
         RowBox[{"4", " ", "Pi", " ", 
          RowBox[{
           RowBox[{"f", "[", "ival", "]"}], "^", "2"}]}]}], "   ", ")"}], " ",
        ",", "\[IndentingNewLine]", "\[IndentingNewLine]", " ", 
       RowBox[{
        RowBox[{"n", "-", 
         RowBox[{"order", "/", "2"}]}], "  ", "<=", " ", "ival"}], ",", " ", 
       "\[IndentingNewLine]", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"FinDiffScheme", "[", " ", 
          RowBox[{"order", ",", 
           RowBox[{"order", "-", "n", "+", "ival"}], ",", "2", ",", 
           "\[Phi]"}], "]"}], " ", "+", "   ", 
         RowBox[{"2", " ", 
          RowBox[{
           RowBox[{"FinDiffScheme", "[", " ", 
            RowBox[{"order", ",", 
             RowBox[{"order", "-", "n", "+", "ival"}], ",", "1", ",", 
             "\[Phi]"}], "]"}], " ", "/", 
           RowBox[{"(", 
            RowBox[{"ival", " ", "h"}], ")"}]}]}], "   ", "-", 
         RowBox[{"4", " ", "Pi", " ", 
          RowBox[{
           RowBox[{"f", "[", "ival", "]"}], "^", "2"}]}]}], "  ", " ", 
        ")"}]}], "  ", "\[IndentingNewLine]", " ", "]"}], " ", "//.", " ", 
     RowBox[{"{", 
      RowBox[{"i", "->", " ", "ival"}], "  ", "}"}]}]}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.957910103897337*^9, 3.957910105833276*^9}, {
