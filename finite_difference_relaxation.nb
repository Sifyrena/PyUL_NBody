Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"testtermsoliton", "[", 
     RowBox[{"nval_", ",", "rmax_", ",", "\[Lambda]_", "  ", ",", "order_"}], 
     "]"}], ":=", " ", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"termphi", "[", 
           RowBox[{"j", ",", " ", "nval", ",", "order"}], "]"}], "^", "2"}], 
         "  ", "+", 
         RowBox[{
          RowBox[{"termf", "[", 
           RowBox[{"j", ",", " ", "nval", ",", "order"}], "]"}], "^", "2"}]}],
         ")"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "0", ",", "nval"}], "}"}]}], "]"}], " ", "//.", 
     "  ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"f", "[", "x_", "]"}], "->", " ", 
        SubscriptBox["f", "x"]}], ",", " ", 
       RowBox[{
        RowBox[{"\[Phi]", "[", "x_", "]"}], "->", " ", 
        SubscriptBox["\[Phi]", "x"]}], " ", ",", 
       RowBox[{
        SubscriptBox["f", "0"], " ", "->", " ", "1"}], ",", 
       RowBox[{"h", "->", " ", 
        RowBox[{"rmax", "/", "nval"}]}], ",", 
       RowBox[{"\[Lambda]int", " ", "->", " ", "\[Lambda]"}], " ", ",", 
       RowBox[{
        SubscriptBox["f", "nval"], " ", "->", " ", "0"}]}], "}"}]}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]"}]}]], "Input",
