Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"FinDiffScheme", "[", 
    RowBox[{"NodeNum_", ",", "DerNode_", ",", "DerOrder_", ",", "f_"}], "]"}],
    ":=", "\[IndentingNewLine]", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "c", ",", "cons", ",", "dervs", ",", "eqn", ",", "num", ",", "ord", ",",
        "serie", ",", "serieCons", ",", "system"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"cons", "=", 
       RowBox[{"Array", "[", 
        RowBox[{"c", ",", "NodeNum"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"eqn", "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Derivative", "[", "DerOrder", "]"}], "[", "f", "]"}], "[", 
         "i", "]"}], "+", 
        RowBox[{
         RowBox[{"Map", "[", 
          RowBox[{"f", ",", 
           RowBox[{"i", "+", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Range", "[", "NodeNum", "]"}], "-", "DerNode"}], 
             ")"}]}]}], "]"}], ".", "cons"}]}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"dervs", "=", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Derivative", "[", "#", "]"}], "[", "f", "]"}], "[", "i", 
           "]"}], "&"}], ",", 
         RowBox[{"Range", "[", 
          RowBox[{"0", ",", 
           RowBox[{"NodeNum", "+", "5"}]}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"serie", "=", 
       RowBox[{"Expand", "[", 
        RowBox[{"eqn", "//.", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"f", "[", 
             RowBox[{"i", "+", "k_"}], "]"}], "->", 
            RowBox[{"Normal", "[", 
             RowBox[{"Series", "[", 
              RowBox[{
               RowBox[{"f", "[", 
                RowBox[{"i", "+", 
                 RowBox[{"h", " ", "k"}]}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"h", ",", "0", ",", 
                 RowBox[{"NodeNum", "+", "5"}]}], "}"}]}], "]"}], "]"}]}], ",",
            " ", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Derivative", "[", "d1_", "]"}], "[", "f", "]"}], "[", 
             RowBox[{"i", "+", "k_"}], "]"}], "->", 
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{"Normal", "[", 
               RowBox[{"Series", "[", 
                RowBox[{
                 RowBox[{"f", "[", 
                  RowBox[{"i", "+", 
                   RowBox[{"h", " ", "k"}]}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"h", ",", "0", ",", 
                   RowBox[{"NodeNum", "+", "5"}]}], "}"}]}], "]"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", "DerOrder"}], "}"}]}], "]"}]}]}], "}"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"system", "=", 
       RowBox[{"Thread", "[", 
        RowBox[{
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Coefficient", "[", 
             RowBox[{
              RowBox[{"Collect", "[", 
               RowBox[{"serie", ",", "dervs"}], "]"}], ",", "#"}], "]"}], 
            "&"}], ",", "dervs"}], "]"}], "==", "0"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"num", "=", "NodeNum"}], ";", "\[IndentingNewLine]", 
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", 
          RowBox[{"First", "[", 
           RowBox[{"Solve", "[", 
            RowBox[{
             RowBox[{"Take", "[", 
              RowBox[{"system", ",", "num"}], "]"}], ",", "cons"}], "]"}], 
           "]"}], "]"}], "=!=", "NodeNum"}], ",", 
        RowBox[{"num", "=", 
         RowBox[{"num", "+", "1"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"cons", "=", 
       RowBox[{"First", "[", 
        RowBox[{"Solve", "[", 
         RowBox[{
          RowBox[{"Take", "[", 
           RowBox[{"system", ",", "num"}], "]"}], ",", "cons"}], "]"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"serieCons", "=", 
       RowBox[{"serie", "/.", "cons"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ord", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "serieCons", "]"}], ">", "1"}], ",", 
         RowBox[{"First", "[", "serieCons", "]"}], ",", "serieCons"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"eqn", "=", 
       RowBox[{"Equal", "@@", 
        RowBox[{"Simplify", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Solve", "[", 
            RowBox[{
             RowBox[{"eqn", "==", "0"}], ",", 
             RowBox[{
              RowBox[{
               RowBox[{"Derivative", "[", "DerOrder", "]"}], "[", "f", "]"}], 
              "[", "i", "]"}]}], "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "1"}], "]"}], "]"}], "/.", "cons"}], "]"}]}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"First", "[", "eqn", "]"}], "==", 
        RowBox[{
         RowBox[{"HoldForm", "[", 
          RowBox[{"Evaluate", "[", 
           RowBox[{"Together", "[", 
            RowBox[{"ExpandAll", "[", 
             RowBox[{"Last", "[", "eqn", "]"}], "]"}], "]"}], "]"}], "]"}], "+", 
         RowBox[{"Row", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{"\"\<O\>\"", ",", "Italic"}], "]"}], ",", "\"\<(\>\"", ",",
             "ord", ",", "\"\<)\>\""}], "}"}], "]"}]}]}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"ReleaseHold", "[", 
       RowBox[{"HoldForm", "[", 
        RowBox[{"Evaluate", "[", 
         RowBox[{"Together", "[", 
          RowBox[{"ExpandAll", "[", 
           RowBox[{"Last", "[", "eqn", "]"}], "]"}], "]"}], "]"}], "]"}], 
       "]"}]}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"FinDiffScheme", "[", 
   RowBox[{"NodeNum_", ",", "DerNode_", ",", "DerOrder_"}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
