Cell[TextData[StyleBox["The \[OpenCurlyDoubleQuote]test\
\[CloseCurlyDoubleQuote] term is the sum of squares of the \
\[OpenCurlyDoubleQuote]errors\[CloseCurlyDoubleQuote] -- the differenced \
terms would be zero for a solution in the continuum limit; we want to \
minimise the resulting sum of squares. ",
 FontColor->RGBColor[
  0.00006103608758678569, 0.0018005645838101779`, 
   0.9982299534599832]]], "Text",
 CellChangeTimes->{{3.957857425781329*^9, 3.957857534682321*^9}, {
