Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"solfinder", "[", 
     RowBox[{"nval_", ",", "rmax_", ",", "\[Lambda]_", "  ", ",", "order_"}], 
     "]"}], " ", ":=", " ", 
    RowBox[{"FindMinimum", "[", 
     RowBox[{
      RowBox[{"Flatten", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Total", "[", 
          RowBox[{"testtermsoliton", "[", 
           RowBox[{"nval", ",", "rmax", ",", "\[Lambda]", ",", "order"}], 
           "]"}], "]"}], " ", ",", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            SubscriptBox["f", 
             RowBox[{"i", " "}]], ">", "0"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", 
             RowBox[{"nval", "-", "1"}]}], "}"}]}], "]"}], ",", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            SubscriptBox["\[Phi]", 
             RowBox[{"i", "+", "1", " "}]], ">", 
            SubscriptBox["\[Phi]", "i"]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "0", ",", 
             RowBox[{"nval", "-", "1"}]}], "}"}]}], "]"}]}], "}"}], "]"}], ",", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            SubscriptBox["f", "i"], ",", 
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", "i"}], "/", "4"}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{"nval", "-", "1"}]}], "}"}]}], "]"}], ",", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            SubscriptBox["\[Phi]", "i"], ",", 
            RowBox[{"-", "1"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "0", ",", "nval"}], "}"}]}], "]"}]}], "]"}], ",", 
      RowBox[{"MaxIterations", "->", "1000"}]}], "]"}]}], ";"}]}]], "Input",
