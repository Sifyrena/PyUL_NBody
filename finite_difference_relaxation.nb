              RowBox[{"{", 
               RowBox[{"h", ",", "0", ",", 
                RowBox[{"NodeNum", "+", "5"}]}], "}"}]}], "]"}], "]"}]}], ",",
           " ", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Derivative", "[", "d1_", "]"}], "[", "f", "]"}], "[", 
            RowBox[{"i", "+", "k_"}], "]"}], "->", 
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"Normal", "[", 
              RowBox[{"Series", "[", 
               RowBox[{
                RowBox[{"f", "[", 
                 RowBox[{"i", "+", 
                  RowBox[{"h", " ", "k"}]}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"h", ",", "0", ",", 
                  RowBox[{"NodeNum", "+", "5"}]}], "}"}]}], "]"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "DerOrder"}], "}"}]}], "]"}]}]}], "}"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"system", "=", 
      RowBox[{"Thread", "[", 
       RowBox[{
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Coefficient", "[", 
            RowBox[{
             RowBox[{"Collect", "[", 
              RowBox[{"serie", ",", "dervs"}], "]"}], ",", "#"}], "]"}], 
           "&"}], ",", "dervs"}], "]"}], "==", "0"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"num", "=", "NodeNum"}], ";", "\[IndentingNewLine]", 
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{"First", "[", 
          RowBox[{"Solve", "[", 
           RowBox[{
            RowBox[{"Take", "[", 
             RowBox[{"system", ",", "num"}], "]"}], ",", "cons"}], "]"}], 
          "]"}], "]"}], "=!=", "NodeNum"}], ",", 
       RowBox[{"num", "=", 
        RowBox[{"num", "+", "1"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"cons", "=", 
      RowBox[{"First", "[", 
       RowBox[{"Solve", "[", 
        RowBox[{
         RowBox[{"Take", "[", 
          RowBox[{"system", ",", "num"}], "]"}], ",", "cons"}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"serieCons", "=", 
      RowBox[{"serie", "/.", "cons"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ord", "=", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "serieCons", "]"}], ">", "1"}], ",", 
        RowBox[{"First", "[", "serieCons", "]"}], ",", "serieCons"}], "]"}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"eqn", "=", 
      RowBox[{"Equal", "@@", 
